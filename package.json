{
  "name": "ufabc-ergonomia",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "description": "Jogo do Algoritmo",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "banner:build": "node scripts/build-banner.mjs",
    "roteiro:gerar": "node scripts/gerar-roteiro.mjs",
    "resumo:gerar": "vitest run tests/unit/resumo.test.ts -u",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "serve": "^14.2.8",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=11"
  }
}
